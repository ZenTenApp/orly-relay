# Marmot Email Bridge — Environment Configuration
# Copy to .env.bridge and edit with your values:
#   cp .env.bridge.example .env.bridge

# ─── Required ───────────────────────────────────────────────

# Email domain (the domain part of user@domain addresses)
ORLY_BRIDGE_DOMAIN=mail.example.com

# Nostr relay WebSocket URL (the bridge connects as a client)
ORLY_BRIDGE_RELAY_URL=wss://relay.example.com

# SMTP inbound port (receives email via MX records)
ORLY_BRIDGE_SMTP_PORT=2525
ORLY_BRIDGE_SMTP_HOST=0.0.0.0

# ─── Identity ──────────────────────────────────────────────

# Bridge identity (nsec bech32 or hex secret key)
# If omitted, auto-generates and saves to $ORLY_BRIDGE_DATA_DIR/bridge.nsec
#ORLY_BRIDGE_NSEC=

# ─── Data ──────────────────────────────────────────────────

# Data directory (stores bridge.nsec and subscriptions.json)
ORLY_BRIDGE_DATA_DIR=/data

# ─── DKIM ──────────────────────────────────────────────────

# Path to DKIM private key PEM file (mounted via volume)
#ORLY_BRIDGE_DKIM_KEY=/dkim/dkim-private.pem
#ORLY_BRIDGE_DKIM_SELECTOR=marmot

# ─── NWC (Lightning Payments) ─────────────────────────────

# NWC connection string for subscription invoices
# Get this from your wallet (Alby Hub, etc.)
#ORLY_BRIDGE_NWC_URI=nostr+walletconnect://...

# Subscription prices in satoshis
ORLY_BRIDGE_MONTHLY_PRICE_SATS=2100
ORLY_BRIDGE_ALIAS_PRICE_SATS=4200

# ─── Outbound SMTP (Smarthost) ────────────────────────────

# SMTP relay for outbound email delivery
# Required unless port 25 is open and your IP has good reputation
#ORLY_BRIDGE_SMTP_RELAY_HOST=smtp.mailgun.org
#ORLY_BRIDGE_SMTP_RELAY_PORT=587
#ORLY_BRIDGE_SMTP_RELAY_USERNAME=
#ORLY_BRIDGE_SMTP_RELAY_PASSWORD=

# ─── ACL (Optional) ───────────────────────────────────────

# gRPC address of ACL server for paid subscription management
# Only needed in split IPC mode with ACL enabled
#ORLY_BRIDGE_ACL_GRPC_SERVER=127.0.0.1:50052

# ─── Profile ─────────────────────────────────────────────

# Path to profile template file (email-header format)
# If present, bridge publishes a kind 0 metadata event on startup
# Default: $ORLY_BRIDGE_DATA_DIR/profile.txt
#ORLY_BRIDGE_PROFILE=/data/profile.txt

# ─── Logging ───────────────────────────────────────────────

ORLY_LOG_LEVEL=info
